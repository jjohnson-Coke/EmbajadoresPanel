{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embajadorespanel",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  // Compila la app antes de cada deploy (Cloudflare no necesita "Build command").
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
